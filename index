<div id="lb"><button class="x" id="lx" aria-label="Fechar">×</button><button class="pv" aria-label="Anterior">←</button><img alt=""><button class="nx" aria-label="Próxima">→</button><div class="ct"></div></div>

<script>
const IMG={"0": "data:image/webp;base64,", "2": "data:image/webp;base64,", "3": "data:image/webp;base64,", "6": "data:image/webp;base64,", "7": "data:image/webp;base64,", "9": "data:image/webp;base64,", "10": "data:image/webp;base64,", "11": "data:image/webp;base64,", "12": "data:image/webp;base64,", "13": "data:image/webp;base64,", "14": "data:image/webp;base64,", "15": "data:image/webp;base64,", "17": "data:image/webp;base64,", "18": "data:image/webp;base64,", "19": "data:image/webp;base64,", "21": "data:image/webp;base64,", "22": "data:image/webp;base64,", "23": "data:image/webp;base64,", "24": "data:image/webp;base64,", "25": "data:image/webp;base64,", "26": "data:image/webp;base64,", "28": "data:image/webp;base64,", "29": "data:image/webp;base64,", "30": "data:image/webp;base64,", "31": "data:image/webp;base64,", "32": "data:image/webp;base64,", "33": "data:image/webp;base64,", "34": "data:image/webp;base64,", "35": "data:image/webp;base64,", "36": "data:image/webp;base64,", "38": "data:image/webp;base64,", "39": "data:image/webp;base64,", "40": "data:image/webp;base64,", "41": "data:image/webp;base64,", "42": "data:image/webp;base64,", "43": "data:image/webp;base64,", "44": "data:image/webp;base64,"};
const P=[
{id:'produtos',cat:'estudio',tag:'Fotos de estúdio',title:'Produtos',meta:'Fotos de estúdio · 01',cover:6,g:[['Joias e acessórios',[6,7,9,10,11]]]},
{id:'brasil',cat:'estudio',tag:'Fotos de estúdio',title:'Temática (Brasil Core)',meta:'Fotos de estúdio · 02',cover:13,g:[['Brasil Core',[12,13,14,15]]]},
{id:'roda',cat:'marcas',tag:'Conteúdo para marcas',title:'Roda do Tempo',meta:'Projeto de conclusão de curso · Administração noturno · CEET Vasco Coutinho · 2024',cover:17,g:[['Relógios, banner e Instagram',[17,18,19,21,22]]]},
{id:'frajola',cat:'marcas',tag:'Conteúdo para marcas',title:'Lanchonete Frajola',meta:'Projeto de estratégias de brand persona, buyer persona e conteúdo para Instagram · Publicinada UVV · 2025',cover:25,g:[['Conteúdo para Instagram',[23,25,24,26]]]},
{id:'navsupply',cat:'exp',tag:'Experiência 1',title:'Navsupply',meta:'Vitória · Julho/2025 – Fevereiro/2026',cover:28,g:[['Instagram feed',[28,29],1],['Instagram Stories',[30,32,31]],['Blog',[33,34],1],['LinkedIn',[35,36]]]},
{id:'almar',cat:'exp',tag:'Experiência 2',title:'ALMAR Incorporadora',meta:'Vila Velha · Março 2026 – Atual',cover:41,g:[['Instagram feed',[38],1],['Instagram Stories',[39,41,40,42,43,44]]]}
];
const $=(s,e=document)=>e.querySelector(s),$$=(s,e=document)=>[...e.querySelectorAll(s)];
const rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
$$('img[data-i]').forEach(i=>i.src=IMG[i.dataset.i]);
$('#herobg').style.backgroundImage=`url(${IMG[0]})`;
// hero title
$('#h1').innerHTML=[...'PORTFÓLIO'].map((c,i)=>`<span style="--i:${i}">${c}</span>`).join('');
// marquee
const tools=['Photoshop','Illustrator','Canva','CapCut','Figma','ChatGPT','Claude','Gemini','Runway','Higgsfield','Fotografia','Vídeo'];
const mq=tools.map(t=>`<span>${t}</span><i>✦</i>`).join('');$('#mq').innerHTML=mq+mq;
// project list
$('#list').innerHTML=P.map((p,i)=>`<button class="row" data-id="${p.id}" data-cat="${p.cat}"><span class="n">${String(i+1).padStart(2,'0')}</span><div><h3>${p.title}</h3><small>${p.meta}</small></div><span class="t">${p.tag}</span><span class="ar">↗</span></button>`).join('');
$$('#chips .chip').forEach(c=>c.onclick=()=>{$$('#chips .chip').forEach(x=>x.classList.toggle('on',x===c));const f=c.dataset.f;$$('.row').forEach(r=>r.classList.toggle('hide',f!=='all'&&r.dataset.cat!==f))});
// hover preview
const peek=$('#peek'),pi=$('img',peek);let tx=0,ty=0,cx=0,cy=0;
if(matchMedia('(hover:hover) and (pointer:fine)').matches&&!rm){
  $$('.row').forEach(r=>{const p=P.find(x=>x.id===r.dataset.id);
    r.addEventListener('mouseenter',()=>{pi.src=IMG[p.cover];peek.classList.add('on')});
    r.addEventListener('mouseleave',()=>peek.classList.remove('on'))});
  addEventListener('mousemove',e=>{tx=e.clientX+30;ty=e.clientY-120});
  (function f(){cx+=(tx-cx)*.12;cy+=(ty-cy)*.12;peek.style.translate=`${cx}px ${cy}px`;requestAnimationFrame(f)})();
}
// modal + lightbox
const modal=$('#modal'),mb=$('#mbody'),lb=$('#lb'),lbi=$('img',lb);let cur=[],ci=0;
function openP(id){const p=P.find(x=>x.id===id);cur=[];let k=0;
  mb.innerHTML=`<p class="label"><b>${p.tag}</b></p><h2>${p.title}</h2><p class="desc">${p.meta}</p>`+p.g.map(([n,ids,w],gi)=>`<div class="grp"><h5><em>${String(gi+1).padStart(2,'0')}</em>${n}</h5><div class="gal">${ids.map(i=>{cur.push(i);return `<button class="${w?'w':''}" style="--k:${k++}" data-k="${cur.length-1}"><img src="${IMG[i]}" alt="${p.title} — ${n}"></button>`}).join('')}</div></div>`).join('');
  $$('.gal button',mb).forEach(b=>b.onclick=()=>show(+b.dataset.k));
  modal.classList.add('on');document.body.classList.add('lock');modal.scrollTop=0;history.replaceState(null,'','#'+id)}
function closeP(){modal.classList.remove('on');document.body.classList.remove('lock');history.replaceState(null,'','#projetos')}
function show(i){ci=(i+cur.length)%cur.length;lbi.classList.add('sw');setTimeout(()=>{lbi.src=IMG[cur[ci]];lbi.classList.remove('sw')},180);$('.ct',lb).textContent=`${ci+1} / ${cur.length}`;lb.classList.add('on')}
$$('.row').forEach(r=>r.onclick=()=>openP(r.dataset.id));
$$('[data-open]').forEach(b=>b.onclick=()=>openP(b.dataset.open));
$('#mx').onclick=closeP;$('#lx').onclick=()=>lb.classList.remove('on');
$('.pv',lb).onclick=()=>show(ci-1);$('.nx',lb).onclick=()=>show(ci+1);
lb.onclick=e=>{if(e.target===lb)lb.classList.remove('on')};
addEventListener('keydown',e=>{if(lb.classList.contains('on')){if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowLeft')show(ci-1);if(e.key==='ArrowRight')show(ci+1)}else if(e.key==='Escape'&&modal.classList.contains('on'))closeP()});
// reveal on scroll
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.15});
$$('.rv,.tl li').forEach(el=>io.observe(el));
// bio word-by-word + progress + parallax + active nav
const bio=$('#bio');bio.innerHTML=bio.textContent.split(' ').map(w=>`<span class="w">${w}</span>`).join(' ');
const ws=$$('.w',bio),tl=$('#tl'),bar=$('#bar'),links=$$('nav a[href^="#"]:not(.logo)'),secs=links.map(a=>$(a.getAttribute('href')));
let tick=false;
function upd(){tick=false;const y=scrollY,h=document.documentElement.scrollHeight-innerHeight;bar.style.transform=`scaleX(${y/h})`;
  if(!rm)$('#herobg').style.translate=`0 ${y*.18}px`;
  const r=bio.getBoundingClientRect(),pr=Math.min(1,Math.max(0,(innerHeight*.85-r.top)/(r.height+innerHeight*.35)));
  ws.forEach((w,i)=>w.classList.toggle('on',i/ws.length<pr*1.05));
  const t=tl.getBoundingClientRect();tl.style.setProperty('--p',Math.min(1,Math.max(0,(innerHeight*.7-t.top)/t.height)));
  let a=-1;secs.forEach((s,i)=>{if(s.getBoundingClientRect().top<innerHeight*.4)a=i});links.forEach((l,i)=>l.classList.toggle('on',i===a))}
addEventListener('scroll',()=>{if(!tick){tick=true;requestAnimationFrame(upd)}},{passive:true});upd();
// card glow
$$('.card').forEach(c=>c.addEventListener('mousemove',e=>{const b=c.getBoundingClientRect();c.style.setProperty('--mx',e.clientX-b.left+'px');c.style.setProperty('--my',e.clientY-b.top+'px')}));
// deep link
if(P.some(p=>'#'+p.id===location.hash))openP(location.hash.slice(1));
</script>
</body>
</html>
