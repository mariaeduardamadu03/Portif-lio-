<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Madu Rodrigues — Portfólio</title>
<meta name="description" content="Portfólio de Maria Eduarda (Madu) Rodrigues — comunicação visual, redes sociais, fotografia e vídeo.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Mrs+Saint+Delafield&family=Hanken+Grotesk:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0a;--ink:#f3eee6;--mute:#9b948a;--line:rgba(243,238,230,.14);--gold:#c8a56a;--serif:'Playfair Display',Georgia,serif;--sans:'Hanken Grotesk',system-ui,sans-serif;--script:'Mrs Saint Delafield','Brush Script MT',cursive;--ease:cubic-bezier(.2,.7,.1,1)}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:300;line-height:1.6;overflow-x:hidden}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
::selection{background:var(--gold);color:#000}
.wrap{width:min(1200px,92%);margin:0 auto}
.label{font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:var(--mute)}
.label b{color:var(--gold);font-weight:400}
#bar{position:fixed;top:0;left:0;height:2px;width:100%;background:var(--gold);transform:scaleX(0);transform-origin:0 50%;z-index:100}
nav{position:fixed;inset:0 0 auto 0;z-index:90;display:flex;justify-content:space-between;align-items:center;padding:22px 4%;mix-blend-mode:difference;color:#fff}
nav .logo{font-family:var(--script);font-size:2rem;line-height:1}
nav ul{display:flex;gap:30px;list-style:none}
nav a{font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;position:relative;padding:4px 0}
nav a::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .5s var(--ease)}
nav a:hover::after,nav a.on::after{transform:scaleX(1)}
@media(max-width:700px){nav ul{gap:14px}nav a{font-size:.6rem;letter-spacing:.14em}}
/* HERO */
#hero{min-height:100svh;position:relative;display:grid;place-items:center;overflow:hidden;text-align:center}
#hero .bg{position:absolute;inset:-8% 0;background-size:cover;background-position:center;filter:grayscale(.3) brightness(.38);transform:scale(1.1);animation:zoom 2.4s var(--ease) forwards}
@keyframes zoom{to{transform:scale(1)}}
#hero h1{font-family:var(--serif);font-weight:400;font-size:clamp(3rem,13.5vw,12.5rem);line-height:.95;letter-spacing:-.02em;position:relative;display:flex;justify-content:center;overflow:hidden;padding:.05em .1em}
#hero h1 span{display:inline-block;transform:translateY(110%);animation:up 1.1s var(--ease) forwards;animation-delay:calc(.5s + var(--i)*.07s)}
@keyframes up{to{transform:none}}
#hero .sub{font-size:clamp(.8rem,1.6vw,1.1rem);letter-spacing:.5em;text-transform:uppercase;margin-top:1.4rem;opacity:0;animation:fade 1s 1.5s forwards;position:relative}
#hero .tags{position:absolute;bottom:34px;left:4%;right:4%;display:flex;justify-content:space-between;font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mute);opacity:0;animation:fade 1s 1.9s forwards}
.cue{display:inline-block;width:1px;height:34px;background:var(--ink);transform-origin:top;animation:cue 1.8s infinite var(--ease);vertical-align:middle;margin-left:12px}
@keyframes cue{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(1);transform-origin:bottom;opacity:0}}
@keyframes fade{to{opacity:1}}
@media(max-width:700px){#hero .tags span:last-child{display:none}}
/* MARQUEE */
.marq{border-block:1px solid var(--line);overflow:hidden;padding:20px 0;white-space:nowrap}
.marq div{display:inline-flex;gap:3rem;animation:mq 32s linear infinite;font-family:var(--serif);font-style:italic;font-size:clamp(1.3rem,3vw,2.2rem)}
.marq:hover div{animation-play-state:paused}
.marq i{color:var(--gold);font-style:normal}
@keyframes mq{to{transform:translateX(-50%)}}
section{padding:clamp(80px,13vw,170px) 0;position:relative}
/* reveal */
.rv{opacity:0;transform:translateY(46px);transition:opacity 1s var(--ease),transform 1.1s var(--ease);transition-delay:var(--d,0s)}
.rv.in{opacity:1;transform:none}
.mask{overflow:hidden;border-radius:2px}
.mask img{transform:scale(1.25);transition:transform 1.6s var(--ease)}
.in .mask img,.mask.in img{transform:scale(1)}
/* ABOUT */
.about{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}
.pics{position:relative;height:clamp(380px,52vw,640px)}
.pics .mask{position:absolute;width:56%;aspect-ratio:3/4}
.pics .mask img{width:100%;height:100%;object-fit:cover}
.pics .a{left:0;top:0}.pics .b{right:0;bottom:0}
.hello{font-family:var(--script);font-size:clamp(2.4rem,5vw,4.2rem);line-height:.9}
.name{font-family:var(--script);font-size:clamp(4.4rem,10vw,8.5rem);line-height:.8;margin:.1em 0 .2em}
.name small{font-family:var(--sans);font-size:.9rem;letter-spacing:.2em;color:var(--gold);margin-left:.5rem}
.bio{font-family:var(--serif);font-style:italic;font-size:clamp(1.1rem,1.9vw,1.55rem);line-height:1.6}
.bio .w{opacity:.2;transition:opacity .4s}.bio .w.on{opacity:1}
@media(max-width:820px){.about{grid-template-columns:1fr}}
/* TITLES */
.title{font-family:var(--serif);font-style:italic;font-weight:700;font-size:clamp(2.6rem,8vw,7rem);line-height:1;letter-spacing:-.02em;margin:.6rem 0 clamp(36px,5vw,70px)}
/* EDU */
.edu{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,6vw,90px)}
.edu p{font-family:var(--serif);font-style:italic;font-size:1.1rem;color:#d9d3c8}
.tl{position:relative;padding-left:34px;margin-top:2rem}
.tl::before{content:"";position:absolute;left:5px;top:6px;bottom:6px;width:1px;background:var(--line)}
.tl .fill{position:absolute;left:5px;top:6px;width:1px;height:calc((100% - 12px)*var(--p,0));background:var(--gold)}
.tl li{list-style:none;position:relative;padding-bottom:30px}
.tl li::before{content:"";position:absolute;left:-34px;top:8px;width:11px;height:11px;border-radius:50%;background:var(--bg);border:1px solid var(--gold);transition:background .5s}
.tl li.in::before{background:var(--gold)}
.tl .y{font-size:.72rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold)}
.tl h4{font-family:var(--serif);font-weight:400;font-size:1.35rem;line-height:1.3}
.tl span{color:var(--mute);font-size:.9rem}
@media(max-width:820px){.edu{grid-template-columns:1fr}}
/* PROJECTS */
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px}
.chip{border:1px solid var(--line);padding:9px 20px;border-radius:99px;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;transition:.35s var(--ease)}
.chip:hover{border-color:var(--ink)}
.chip.on{background:var(--ink);color:#000;border-color:var(--ink)}
.list{border-top:1px solid var(--line)}
.row{display:grid;grid-template-columns:70px 1fr auto 40px;align-items:center;gap:20px;padding:30px 4px;border-bottom:1px solid var(--line);width:100%;text-align:left;position:relative;transition:padding .6s var(--ease),opacity .5s,max-height .6s var(--ease)}
.row .n{font-family:var(--serif);font-style:italic;color:var(--gold);font-size:1.1rem}
.row h3{font-family:var(--serif);font-weight:400;font-size:clamp(1.5rem,3.6vw,3rem);line-height:1.1;transition:transform .6s var(--ease)}
.row small{display:block;color:var(--mute);font-size:.85rem;margin-top:6px;max-width:60ch}
.row .t{font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mute)}
.row .ar{font-size:1.5rem;transition:transform .5s var(--ease)}
.row:hover{padding-left:24px}
.row:hover .ar{transform:translate(6px,-6px);color:var(--gold)}
.row.hide{opacity:0;max-height:0;padding-block:0;overflow:hidden;border:0;pointer-events:none}
.row:not(.hide){max-height:260px}
#peek{position:fixed;left:0;top:0;width:240px;aspect-ratio:4/5;pointer-events:none;z-index:60;opacity:0;transform:scale(.7);transition:opacity .35s,transform .5s var(--ease);overflow:hidden;border-radius:3px}
#peek.on{opacity:1;transform:scale(1)}
#peek img{width:100%;height:100%;object-fit:cover}
@media(max-width:700px){.row{grid-template-columns:44px 1fr 30px}.row .t{display:none}}
/* EXP */
.exp{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,50px)}
.card{border:1px solid var(--line);padding:clamp(26px,4vw,48px);position:relative;overflow:hidden;transition:border-color .5s,transform .6s var(--ease)}
.card::before{content:"";position:absolute;inset:0;background:radial-gradient(500px circle at var(--mx,50%) var(--my,0%),rgba(200,165,106,.13),transparent 60%);opacity:0;transition:opacity .5s}
.card:hover{border-color:rgba(200,165,106,.5);transform:translateY(-6px)}
.card:hover::before{opacity:1}
.card>*{position:relative}
.card h3{font-family:var(--serif);font-size:clamp(1.7rem,3vw,2.4rem);font-weight:400;margin:.6rem 0 .2rem}
.card .when{color:var(--gold);font-size:.85rem;letter-spacing:.1em}
.card p{margin-top:1.1rem;color:#d9d3c8}
.card p b{display:block;font-weight:400;font-size:.7rem;letter-spacing:.24em;text-transform:uppercase;color:var(--mute);margin-bottom:2px}
.btn{display:inline-flex;align-items:center;gap:10px;margin-top:1.6rem;border-bottom:1px solid var(--gold);padding-bottom:4px;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;transition:gap .4s var(--ease)}
.btn:hover{gap:20px}
@media(max-width:820px){.exp{grid-template-columns:1fr}}
/* CONTACT */
#contato{text-align:center;border-top:1px solid var(--line)}
#contato svg{width:84px;margin:0 auto 10px;stroke:var(--ink);fill:none;stroke-width:1.2}
#contato .big{font-family:var(--script);font-size:clamp(5rem,17vw,15rem);line-height:.85;display:block;transition:letter-spacing .8s var(--ease),color .5s}
#contato .big:hover{color:var(--gold);letter-spacing:.02em}
.links{display:flex;flex-wrap:wrap;gap:clamp(20px,5vw,60px);justify-content:center;margin-top:3rem;font-family:var(--serif);font-size:clamp(1.1rem,2vw,1.6rem)}
.links a{border-bottom:1px solid var(--line);padding-bottom:4px;transition:.4s}
.links a:hover{border-color:var(--gold);color:var(--gold)}
footer{padding:30px 4%;display:flex;justify-content:space-between;color:var(--mute);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase}
/* MODAL + LIGHTBOX */
#modal{position:fixed;inset:0;z-index:120;background:rgba(10,10,10,.97);overflow-y:auto;opacity:0;visibility:hidden;transform:translateY(40px);transition:opacity .5s,transform .7s var(--ease),visibility 0s .7s}
#modal.on{opacity:1;visibility:visible;transform:none;transition-delay:0s}
#modal .in2{width:min(1100px,92%);margin:0 auto;padding:110px 0 80px}
#modal h2{font-family:var(--serif);font-style:italic;font-weight:700;font-size:clamp(2.2rem,6vw,5rem);line-height:1.05;margin:.6rem 0 1rem}
#modal .desc{color:#d9d3c8;max-width:70ch;font-family:var(--serif);font-style:italic;font-size:1.15rem}
.x{position:fixed;top:22px;right:4%;z-index:130;width:52px;height:52px;border:1px solid var(--line);border-radius:50%;font-size:1.3rem;transition:.4s var(--ease);background:rgba(10,10,10,.6)}
.x:hover{background:var(--ink);color:#000;transform:rotate(90deg)}
.grp{margin-top:56px}
.grp h5{font-weight:400;font-family:var(--serif);font-size:1.4rem;margin-bottom:18px;display:flex;gap:14px;align-items:baseline}
.grp h5 em{color:var(--gold);font-size:.9rem}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.gal button{overflow:hidden;background:#161616;aspect-ratio:4/5;position:relative}
.gal button.w{aspect-ratio:16/11}
.gal img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease),filter .6s;filter:saturate(.9)}
.gal button:hover img{transform:scale(1.07);filter:none}
.gal button{opacity:0;transform:translateY(24px);animation:gin .8s var(--ease) forwards;animation-delay:calc(var(--k)*70ms + .25s)}
@keyframes gin{to{opacity:1;transform:none}}
#lb{position:fixed;inset:0;z-index:140;background:rgba(0,0,0,.94);display:grid;place-items:center;opacity:0;visibility:hidden;transition:opacity .4s,visibility 0s .4s}
#lb.on{opacity:1;visibility:visible;transition-delay:0s}
#lb img{max-width:90vw;max-height:86vh;object-fit:contain;transition:opacity .3s,transform .5s var(--ease)}
#lb img.sw{opacity:0;transform:scale(.96)}
#lb .pv,#lb .nx{position:absolute;top:50%;transform:translateY(-50%);font-size:2rem;padding:20px;transition:.3s}
#lb .pv{left:1%}#lb .nx{right:1%}
#lb .pv:hover,#lb .nx:hover{color:var(--gold)}
#lb .ct{position:absolute;bottom:22px;left:0;right:0;text-align:center;font-size:.72rem;letter-spacing:.3em;color:var(--mute)}
body.lock{overflow:hidden}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-delay:0s!important;transition-duration:.01ms!important}.rv{opacity:1;transform:none}#hero h1 span{transform:none}#hero .sub,#hero .tags{opacity:1}}
</style>
</head>
